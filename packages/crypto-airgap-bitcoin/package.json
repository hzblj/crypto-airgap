{
  "name": "@hzblj/crypto-airgap-bitcoin",
  "version": "0.2.0",
  "description": "Bitcoin air-gapped signing for @hzblj/crypto-airgap: PSBTs as crypto-psbt both ways, P2WPKH and Taproot, checked against the request and finalized by @hzblj/crypto-bitcoin, and accounts as crypto-account and crypto-output descriptors (wpkh, tr). No UI, no camera.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/crypto-airgap.git",
    "directory": "packages/crypto-airgap-bitcoin"
  },
  "bugs": {
    "url": "https://github.com/hzblj/crypto-airgap/issues"
  },
  "homepage": "https://github.com/hzblj/crypto-airgap/tree/main/packages/crypto-airgap-bitcoin#readme",
  "keywords": [
    "air-gap",
    "bc-ur",
    "bip174",
    "bip86",
    "bitcoin",
    "crypto-account",
    "crypto-psbt",
    "hardware-wallet",
    "psbt",
    "qr",
    "react-native",
    "taproot",
    "wallet"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@hzblj/crypto-airgap": "workspace:^",
    "@hzblj/crypto-bitcoin": "^0.3.0"
  },
  "peerDependencies": {
    "@hzblj/nitro-crypto": "^0.1.5"
  },
  "devDependencies": {
    "@hzblj/nitro-crypto": "^0.1.5",
    "@keystonehq/bc-ur-registry": "0.8.1",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
